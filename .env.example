# Canvas Dashboard settings
# Copy this file to .env and fill it in. Files named .env* are never committed.

# --- Required in production -------------------------------------------------

# Secret that encrypts the login cookie. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# --- Login (optional) -------------------------------------------------------

# Show "Login via Canvas token" on the landing page. 1 = on, 0 = off.
MANUAL_MODE=0

# Only allow token login for these Canvas sites (comma-separated).
# Leave empty to allow any public https Canvas site.
# Example: ALLOWED_CANVAS_HOSTS=canvas.your-school.edu
ALLOWED_CANVAS_HOSTS=

# The Telegram bot's server, which checks login links and asks you to approve.
# Leave empty for the default: https://canvas.sonungo.com
PORTAL_URL=

# Shared secret with the bot's server (set the same PORTAL_API_KEY there), so only
# this site can ask it for logins. Generate one with: openssl rand -hex 32
# Set it here first, then on the bot's server.
PORTAL_API_KEY=

# The Telegram approval message shows the approximate location of the login.
# It comes from hosting headers, or from an IP lookup on ipapi.co. 0 = no lookup.
LOCATION_LOOKUP=1

# The site's public address, used in the sitemap and link previews.
# Leave empty on Vercel (it knows the domain); otherwise e.g. https://your-domain.com
SITE_URL=

# --- Local development only -------------------------------------------------

# 1 = skip login and use the Canvas account below on every page.
# Only works with `npm run dev`; production builds ignore it.
DEV_MODE=0

# Your Canvas site and a personal access token
# (Canvas -> Account -> Settings -> Approved Integrations -> New Access Token).
# Example: CANVAS_BASE_URL=https://canvas.your-school.edu
CANVAS_BASE_URL=
CANVAS_API_TOKEN=
